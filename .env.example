# ============================================================
# Business Identity
# ============================================================
BUSINESS_NAME="Your Business Name"
BUSINESS_TAGLINE="Your Tagline Here"
BUSINESS_ABOUT_EN="Your business description in English."
BUSINESS_ABOUT_ES="Your business description in Spanish."
BUSINESS_EMAIL=you@yourdomain.com
BUSINESS_CITY="Your City"
BUSINESS_STATE=OK
BUSINESS_DELIVERY_AREA="Your delivery area"
BUSINESS_HOURS=

# ============================================================
# Social Media
# ============================================================
FACEBOOK_URL=https://www.facebook.com/yourbrand/
INSTAGRAM_HANDLE=yourbrand
INSTAGRAM_URL=https://www.instagram.com/yourbrand
WHATSAPP_PHONE=your_phone_digits_only
BUSINESS_PHONE="(555) 000-0000"

# ============================================================
# Payment
# ============================================================
ZELLE_PHONE=your_phone_digits_only
CASHAPP_TAG='$yourcashtag'

# ============================================================
# DoorDash
# ============================================================
DOORDASH_STORE_ID=your_value_here
DOORDASH_STORE_URL=https://your-doordash-store-url
DOORDASH_BUSINESS_SLUG=your-doordash-slug
DOORDASH_ENABLED=true
DOORDASH_ORDER_ONLINE_URL=https://order.online/business/your-slug
GOOGLE_REVIEW_URL=https://g.page/r/CXreQ_QPNWNOEBM/review
BUSINESS_SALES_TAX_RATE=0.08517
GOOGLE_MAPS_API_KEY=your_value_here
BUSINESS_ADDRESS="6134 S Troost Ave, Tulsa, OK 74136"
BUSINESS_STREET_ADDRESS=your_street_address
BUSINESS_POSTAL_CODE=your_postal_code
BUSINESS_LAT=36.0814
BUSINESS_LNG=-95.9987
BUSINESS_DELIVERY_BASE_MILES=5
BUSINESS_DELIVERY_BASE_FEE=10
BUSINESS_DELIVERY_PER_MILE_FEE=1
# Same-day order cutoff (24h H:i, America/Chicago). After this time the checkout
# date picker's earliest selectable day rolls to tomorrow.
BUSINESS_SAMEDAY_CUTOFF=13:00

# ============================================================
# Google Merchant Center
# ============================================================
GOOGLE_MERCHANT_ID=your_value_here
# Full data-source resource name: accounts/{merchant_id}/dataSources/{datasource_id}
GOOGLE_MERCHANT_DATASOURCE=your_value_here
GOOGLE_MERCHANT_ENABLED=false
# Service-account JSON key path. Store it OUTSIDE the web root (an absolute path
# is safest, e.g. /home/USER/secure_keys/google-service-account.json); never commit it.
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=../config/google-service-account.json
# Google product taxonomy. 2899 = Fresh Cut Flowers (numeric id avoids string-match errors).
GOOGLE_PRODUCT_CATEGORY=2899

# ============================================================
# Database
# ============================================================
DB_HOST=your_db_host
DB_NAME=your_db_name
DB_USER_FULL=your_db_user
DB_PASS_FULL=your_value_here
DB_USER_RW=your_db_user
DB_PASS_RW=your_value_here
DB_USER_RO=your_db_user
DB_PASS_RO=your_value_here

# ============================================================
# Tawk.to Chat Widget (get from tawk.to dashboard after signup)
# ============================================================
TAWKTO_PROPERTY_ID=your_value_here
TAWKTO_WIDGET_ID=your_value_here

# ============================================================
# Twilio SMS
# ============================================================
TWILIO_ACCOUNT_SID=your_value_here
TWILIO_AUTH_TOKEN=your_value_here
TWILIO_FROM_NUMBER=your_phone_digits_only

# ============================================================
# SMTP (transactional email)
# ============================================================
SMTP_HOST=your_smtp_host
SMTP_PORT=587
SMTP_USER=you@yourdomain.com
SMTP_PASS=your_value_here
SMTP_FROM_EMAIL=you@yourdomain.com
SMTP_FROM_NAME="Your Business Name"

# ============================================================
# Analytics & Tracking
# ============================================================
GA4_MEASUREMENT_ID=your_value_here
META_PIXEL_ID=your_value_here
META_IG_ACCESS_TOKEN=your_value_here
META_IG_USER_ID=your_value_here

# Google Ads conversion tracking. GOOGLE_ADS_ID is the tag id (AW-...); the labels
# are the per-conversion-action ids from Google Ads > Goals > Conversions. gtag.js is
# shared with GA4 above — the layout loads the library once and issues one
# gtag('config', ...) per configured id. Leave GOOGLE_ADS_ID empty to disable Ads
# tracking; leave an individual label empty to disable just that conversion.
GOOGLE_ADS_ID=your_value_here
GOOGLE_ADS_PURCHASE_LABEL=your_value_here
GOOGLE_ADS_LEAD_LABEL=your_value_here

# ============================================================
# Facebook Marketing API (Ad Campaigns)
# ============================================================
META_AD_ACCOUNT_ID=your_value_here
META_ADS_ACCESS_TOKEN=your_value_here
META_APP_ID=your_value_here

# ============================================================
# Theme (CSS custom properties — injected into <head> by layout)
# ============================================================
COLOR_PRIMARY="#B55AA0"
COLOR_ACCENT="#D4409A"
COLOR_BG_DARK="#0D0D0D"
COLOR_BG_LIGHT="#FAF7FA"
COLOR_TEXT_DARK="#1A1A1A"
COLOR_TEXT_LIGHT="#FFFFFF"
COLOR_MUTED="#999999"
COLOR_BORDER="#E8D5E8"

# ============================================================
# Stripe
# ============================================================
STRIPE_KEY=pk_live_...
STRIPE_SECRET=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Reusable Stripe Tax Rate object id (create once in the Stripe dashboard or via
# the API); attached to taxable line items so Stripe reports collected sales tax.
STRIPE_TAX_RATE_ID=txr_...
# Absolute path to the CLI php binary, used by App\Support\CliRelay to run
# outbound-HTTPS calls (Stripe, Twilio) through bin/cli-relay.php when invoked
# from a web request (see docs/stripe-cli-relay.md for why). Defaults to
# /usr/local/bin/php82 (this project's pair.com host) when unset.
PHP_CLI_BINARY=/usr/local/bin/php82

# ============================================================
# App
# ============================================================
APP_ENV=production
APP_DEBUG=false
APP_URL=https://yourdomain.com
ADMIN_SESSION_LIFETIME=7200
VIP_SPEND_THRESHOLD=200
