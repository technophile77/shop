# ============================================================
# Business Identity
# ============================================================
BUSINESS_NAME="Your Business Name"
BUSINESS_TAGLINE="Your Tagline Here"
BUSINESS_ABOUT_EN="Your business description in English."
BUSINESS_ABOUT_ES="Your business description in Spanish."
BUSINESS_EMAIL=you@yourdomain.com
BUSINESS_CITY=Your City
BUSINESS_STATE=OK
BUSINESS_DELIVERY_AREA=Your delivery area
BUSINESS_HOURS=

# ============================================================
# Social Media
# ============================================================
FACEBOOK_URL=https://www.facebook.com/yourbrand/
INSTAGRAM_HANDLE=yourbrand
INSTAGRAM_URL=https://www.instagram.com/yourbrand
WHATSAPP_PHONE=your_phone_digits_only

# ============================================================
# Payment
# ============================================================
ZELLE_PHONE=your_phone_digits_only
CASHAPP_TAG=$yourcashtag

# ============================================================
# DoorDash
# ============================================================
DOORDASH_STORE_ID=your_value_here
DOORDASH_STORE_URL=https://your-doordash-store-url
DOORDASH_BUSINESS_SLUG=your-doordash-slug
DOORDASH_ENABLED=true

# ============================================================
# Database
# ============================================================
DB_HOST=your_db_host
DB_NAME=your_db_name
DB_USER_FULL=your_db_user
DB_PASS_FULL=your_value_here
DB_USER_RW=your_db_user
DB_PASS_RW=your_value_here
DB_USER_RO=your_db_user
DB_PASS_RO=your_value_here

# ============================================================
# Tawk.to Chat Widget (get from tawk.to dashboard after signup)
# ============================================================
TAWKTO_PROPERTY_ID=your_value_here
TAWKTO_WIDGET_ID=your_value_here

# ============================================================
# Twilio SMS
# ============================================================
TWILIO_ACCOUNT_SID=your_value_here
TWILIO_AUTH_TOKEN=your_value_here
TWILIO_FROM_NUMBER=your_phone_digits_only

# ============================================================
# SMTP (transactional email)
# ============================================================
SMTP_HOST=your_smtp_host
SMTP_PORT=587
SMTP_USER=you@yourdomain.com
SMTP_PASS=your_value_here
SMTP_FROM_EMAIL=you@yourdomain.com
SMTP_FROM_NAME="Your Business Name"

# ============================================================
# Analytics & Tracking
# ============================================================
GA4_MEASUREMENT_ID=your_value_here
META_PIXEL_ID=your_value_here
META_IG_ACCESS_TOKEN=your_value_here
META_IG_USER_ID=your_value_here

# ============================================================
# Facebook Marketing API (Ad Campaigns)
# ============================================================
META_AD_ACCOUNT_ID=your_value_here
META_ADS_ACCESS_TOKEN=your_value_here
META_APP_ID=your_value_here

# ============================================================
# Theme (CSS custom properties — injected into <head> by layout)
# ============================================================
COLOR_PRIMARY=#B55AA0
COLOR_ACCENT=#D4409A
COLOR_BG_DARK=#0D0D0D
COLOR_BG_LIGHT=#FAF7FA
COLOR_TEXT_DARK=#1A1A1A
COLOR_TEXT_LIGHT=#FFFFFF
COLOR_MUTED=#999999
COLOR_BORDER=#E8D5E8

# ============================================================
# App
# ============================================================
APP_ENV=production
APP_DEBUG=false
APP_URL=https://yourdomain.com
ADMIN_SESSION_LIFETIME=7200
VIP_SPEND_THRESHOLD=200
