# Secrets — NEVER commit
.env

# Google service-account key — NEVER commit
config/google-service-account.json
*.service-account.json
# Google downloads keys as <project-id>-<hash>.json; ignore any such key for this project
perlas-flowers-*.json
*.iam.gserviceaccount.com.json

# Composer dependencies (installed on server via `composer install`)
/vendor/

# PHPUnit (dev-only; phar/cache are never committed)
/.phpunit.cache/
/phpunit.phar

# User-uploaded content (managed on server, not in repo)
/public/uploads/

# Logs
*.log
/logs/

# System & IDE junk
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Claude Code workspace
.claude/

# PHP error dumps
*.php~
/tmp/

# Database dumps / backups (may contain data) — but NOT migrations
*.sql.gz
/backup*.sql
/dump*.sql

# Explicitly track the migrations directory
!/migrations/*.sql

# OS temp files
desktop.ini
